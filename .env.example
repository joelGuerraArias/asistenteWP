# WordPress Connection (Required)
# Copia este archivo a .env y completa tus credenciales
WORDPRESS_SITE_URL=https://tu-sitio.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Método de autenticación: app-password | jwt | basic | api-key
WORDPRESS_AUTH_METHOD=app-password

# Opcional
DEBUG=false
LOG_LEVEL=info

# Categorías por defecto en cada post (fv se mapea a slug fb en fvdigital.do)
DEFAULT_CATEGORIES=fv,tweet2
DEFAULT_POST_STATUS=draft

# Telegram Bot — crea bot con @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ECHO_ONLY=false
# Tu chat ID (opcional, deja vacío para permitir todos). Obtén con @userinfobot
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BUFFER_MS=12000

# Servidor local de estado (health check)
BOT_PORT=9000

# Audio — STT: groq (rápido) | mistral | auto
SPEECH_PROVIDER=groq
MISTRAL_API_KEY=
MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
# pabmatos (custom) — id de https://api.mistral.ai/v1/audio/voices
MISTRAL_TTS_VOICE_ID=cccea7b3-4ebc-42af-92a6-f4ac3ba8215d
MISTRAL_CHAT_MODEL=mistral-small-latest
SPEECH_LANGUAGE=es
TTS_LANGUAGE=es
VOICE_REPLIES=true
GROQ_API_KEY=

# /trad — ES: reel 9:16 | otro idioma: doblaje pabmatos + 9:16
TRAD_VOICE_ID=cccea7b3-4ebc-42af-92a6-f4ac3ba8215d
TRAD_ORIGINAL_VOLUME=0.05
TRAD_DUB_VOLUME=2
TRAD_HEADLINE_DELAY=7
TRAD_HEADLINE_TYPE_SECONDS=2
TRAD_HEADLINE_VISIBLE_SECONDS=10
TRAD_WIDTH=1080
TRAD_HEIGHT=1920
# Overlay de marca (logo FV). Por defecto OFF. true = assets/trad-overlay.png
TRAD_OVERLAY=false
TRAD_OVERLAY_PATH=

# /dub — ElevenLabs Dubbing API (siempre a español)
ELEVENLABS_API_KEY=
# DUB_SOURCE_LANGUAGE=en
# DUB_MODEL_ID=dubbing_v2
# DUB_POLL_MS=5000
# DUB_MAX_WAIT_MS=1500000
FFMPEG_PATH=

# /ndigital — crop overlays N Digital + trim final (valores fijos actuales)
NDIGITAL_CROP_TOP=200
NDIGITAL_CROP_BOTTOM=565
NDIGITAL_TRIM_END_SEC=6
NDIGITAL_LOGO_PAD_TOP=16
NDIGITAL_TITLE_BAND=200

# Bumper SIE al final de videos a FV Digital
SIE_BUMPER_ENABLED=true
SIE_BUMPER_DIR=C:\Users\Joel Guerra\Desktop\VideoCreator\sie

# Cron SIE 06:00 — 1 video/día: STT (solo 1ª vez, cache .sie-transcripts.json) + caption → FV
# Sin logo ni lower-third. Rotación aparte del bumper.
SIE_PUBLISH_ENABLED=true
SIE_PUBLISH_CRON_TIME=06:00

# Tarjeta social — gráfico 400x400 tras publicar (fondo=imagen, titular, tag rojo, logo)
SOCIAL_CARD=true
SOCIAL_CARD_SIZE=1080
SOCIAL_CARD_HANDLE=#fvdigital.do
SOCIAL_CARD_SITE=www.fvdigital.do

PUBLISH_WEBHOOK=true
PUBLISH_WEBHOOK_URL=https://meny.app.n8n.cloud/webhook/fvdigital
PUBLISH_WEBHOOK_HASHTAG=#fvdigital
PUBLISH_WEBHOOK_SOURCE=asistente-wp

F1RD_WEBHOOK=true
F1RD_WEBHOOK_URL=https://meny.app.n8n.cloud/webhook/formula1rd
F1RD_WEBHOOK_HASHTAG=#Formula1RD

# Cloudflare R2 (almacenamiento S3-compatible para las tarjetas)
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# /video — descarga YouTube/Instagram/Facebook/X → R2 → webhook
YTDLP_PATH=
YTDLP_COOKIES_FROM_BROWSER=
# Si Chrome falla con DPAPI, usa cookies Netscape exportadas (prioridad sobre browser):
YTDLP_COOKIES_FILE=
SOCIAL_VIDEO_MAX_MB=90

# /foto — video Termómetro FV Digital (fondo base + foto sin fondo + texto máquina de escribir)
# TERMOMETRO_FRAME_PATH=assets/termometro-frame.png
# TERMOMETRO_DURATION_SECONDS=30
# TERMOMETRO_TYPEWRITER_START_SECONDS=3
# TERMOMETRO_TYPEWRITER_DURATION_SECONDS=4
# TERMOMETRO_FPS=30

# /trad (ver también TRAD_* arriba junto a Mistral TTS)

# HeyGen — videos con avatar (CLI en ~/.local/bin)
HEYGEN_VIDEO=true
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_ORIENTATION=portrait

# Proyectos de video integrados en la app
HYPERFRAMES_ENABLED=true
REMOTION_ENABLED=true
HYPERFRAMES_DIR=video/hyperframes
REMOTION_DIR=video/remotion
FRASE_HYPERFRAMES_DIR=video/frase-celebre
FRASE_CRON_TIME=08:00

# Feed FV → redes (cada hora :15 de 09:15 a 21:15, nunca repite)
FEED_REPOST_ENABLED=true
FEED_REPOST_URL=https://fvdigital.do/feed
# FV Digital: 4 noticias nuevas por corrida
FEED_REPOST_COUNT=4
FEED_REPOST_START=09:15
FEED_REPOST_END=21:15
FEED_REPOST_FV=true
# Motorsport F1 (lat) → webhook formula1rd
FEED_REPOST_F1=true
FEED_REPOST_F1_URL=https://lat.motorsport.com/rss/f1/news/
# F1RD: 2 noticias nuevas por corrida (si se deja vacío hereda FEED_REPOST_COUNT)
FEED_REPOST_F1_COUNT=2

# Encuestas (carpeta TXT + fotos PNG/JPG)
ENCUESTAS_DIR=encuestas
# Temáticas (ALPHA): una a las 09:00 y otra a las 16:00; al agotar el MD reinicia
ENCUESTAS_CRON_TIME=09:00,16:00
ENCUESTAS_MODE=tema
ENCUESTAS_CHECK_TIME=
ENCUESTAS_DAILY_COUNT=1

# Noticias — firma al pie de cada artículo
NEWS_AUTHOR_SIGNATURE=Milton Jerez — conversación y redacción

# Tavily — búsqueda enriquecida para /wp y /escribir (datos concretos, medios RD)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=8
TAVILY_TIME_RANGE=week

# Brave Search API — /busca (localizar titular + borrador de correo)
# https://brave.com/search/api/
BRAVE_API_KEY=

# Brevo SMTP — correos diarios Intrant / Edesur
BREVO_API_KEY=
# API v3 de Brevo (xkeysib-...) — alternativa HTTPS/443 cuando el SMTP está bloqueado (VPN/ISP)
BREVO_API_V3_KEY=

BREVO_SMTP_USER=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=info@fgjmedios.com
BREVO_SENDER_NAME=FGJ Medios - Sistema de Análisis
INFORMES_DIR=
INFORME_EMAIL_INTRANT=
# CC fijo por defecto: belgicajr@gmail.com. Se puede sobreescribir desde aquí.
INFORME_EMAIL_INTRANT_CC=belgicajr@gmail.com
# false = pausa envíos/sync Edesur; Intrant sigue normal
EDESUR_ENABLED=true
INFORME_EMAIL_EDESUR=
INFORME_EMAIL_EDESUR_CC=
INFORME_CRON_TIMES=17:00,23:00

# DGCP Digest — resumen de licitaciones de comprasdominicana.gob.do
DGCP_DIGEST_URL=https://comunidad.comprasdominicana.gob.do/Public/Tendering/ContractNoticeManagement/Index
DGCP_DIGEST_TO=autosemana@gmail.com
DGCP_DIGEST_KEYWORDS=web,aplicación,aplicaciones,streaming,monitoreo,relaciones públicas,encuestas,python,react,montaje,eventos,tecnología,zoom,adobe,fortinet,openai,claude,inteligencia artificial,plataforma,informático,equipos informáticos,accesorios informáticos,licencia,licencias,antivirus,suscripción,seguridad,comunicaciones,mantenimiento de vehículos
DGCP_DIGEST_CRON_TIMES=08:00,17:00

# Google OAuth (Drive/Sheets/Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_ALERTS_SHEET_ID=
GOOGLE_ALERTS_SHEET_NAME=Hoja 1
GOOGLE_ALERTS_SHEET_FILE=intrant
GOOGLE_ALERTS_FILTERS=intrant
GOOGLE_ALERTS_CRON_TIMES=07:00,16:30

# REPORTE Intrant (envío 07:30; Gmail ya corrió a las 07:00)
INTRANT_REPORT_CRON_TIMES=07:30,17:00

# Así va el día — alertas del sheet Intrant → correo (12:00 y 16:00)
ASI_VA_EL_DIA_ENABLED=true
ASI_VA_EL_DIA_CRON_TIMES=12:00,16:00

# Noticias oficiales del sitio INTRANT (intrant.gob.do/noticias) — solo si hay nuevas
# TO = INFORME_EMAIL_INTRANT + EXTRA_TO; CC = INFORME_EMAIL_INTRANT_CC (+ belgicajr)
INTRANT_SITE_NEWS_CRON_TIMES=08:00,18:00
INTRANT_SITE_NEWS_EXTRA_TO=autosemana@gmail.com
# INTRANT_SITE_NEWS_URL=https://intrant.gob.do/noticias/
APIFY_TOKEN=
RAPIDAPI_KEY=
INTRANT_TWITTER_QUERY=@INTRANT_RD
# Opcional: perfiles IG para --refresh=instagram (URLs separadas por coma)
INTRANT_IG_START_URLS=
# Facebook menciones: scraper_one/facebook-posts-search (query "INTRANT RD", no "Intrant")
# INTRANT_FB_QUERY=INTRANT RD
# INTRANT_FB_RESULTS_LIMIT=12
# INTRANT_FB_SEARCH_DAYS=3
# INTRANT_FB_DATASET_URL=https://api.apify.com/v2/acts/scraper_one~facebook-posts-search/runs/last/dataset/items?status=SUCCEEDED
# INTRANT_FB_REFRESH_URL=https://api.apify.com/v2/acts/scraper_one~facebook-posts-search/run-sync-get-dataset-items

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=medium

# Mistral — visión, OCR y audio
MISTRAL_VISION_MODEL=pixtral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Fallbacks opcionales (TTS: Mistral → OpenAI cedar | STT: primario → OpenAI whisper-1)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_INSTRUCTIONS=Speak clear Spanish with a natural news presenter tone.

# FTP opcional — despliegue automático de plugins (Plesk)
# WORDPRESS_FTP_HOST=
# WORDPRESS_FTP_USER=
# WORDPRESS_FTP_PASSWORD=
# WORDPRESS_FTP_MU_PLUGINS_PATH=/httpdocs/wp-content/mu-plugins

# ── Monitoreo de Instagram (buscadores Tavily/Serper/Brave; sin Apify) ──
# SERPER_API_KEY=            # plan gratis: sin site:, inurl: ni comillas (el código ya lo respeta)
# IG_MONITOR_DAYS=0          # correo de estado: 0 = solo hoy
# IG_REPORT_DAYS=1           # REPORTE 07:30/17:00: hoy + ayer
# IG_MONITOR_EXCLUDE_ACCOUNTS=intrant_rd,intrantrd   # cuenta propia: no se reporta como mención
# IG_MONITOR_CLIENT_ACCOUNT=intrant_rd               # último post + comentarios
# Cookies de una cuenta SECUNDARIA (opcional; importar con instagram-monitor/IMPORTAR-COOKIES.cmd)
# IG_SESSIONID=
# IG_CSRFTOKEN=
# IG_DS_USER_ID=
# IG_MONITOR_RESOLVE_OWNER=false   # true = averigua dueño de cada post (más consultas a Instagram)

# ── Estado de redes (Instagram + X) → correo Intrant ──
# SOCIAL_REPORT_CRON_TIMES=09:00,17:00
# TWITTER_RAPIDAPI_KEY=      # twitter-api47 (RapidAPI); vacío = usa RAPIDAPI_KEY
# TWITTER_RAPIDAPI_HOST=twitter-api47.p.rapidapi.com
# INTRANT_TWITTER_QUERY=@INTRANT_RD

# ── AIsa (modelos + data APIs vía https://api.aisa.one) ──
# Consola: https://console.aisa.one/api-keys
# MCP preferido en Cursor: https://mcp.aisa.one/mcp
# AISA_API_KEY=sk-aisa-...
# AISA_BASE_URL=https://api.aisa.one/v1

# ── YouTube (API oficial; gratis, cuota diaria) ──
# YOUTUBE_API_KEY=
# YT_CLIENT_CHANNEL_ID=       # canal oficial del INTRANT (si se deja vacío se busca y se guarda en .youtube-channel.json)
# YT_DAYS=2                   # YouTube: hoy + 2 días atrás (últimos 3 días), correo y REPORTE
# Íconos de redes para correos: assets/redes/instagram.png, x.png, youtube.png (PNG oficiales)
