{
  "name": "asistente-wp",
  "version": "2.6.0",
  "private": true,
  "description": "Asistente WordPress para Cursor via mcp-wordpress",
  "type": "module",
  "scripts": {
    "mcp": "node node_modules/mcp-wordpress/dist/index.js",
    "test:connection": "powershell -ExecutionPolicy Bypass -File scripts/test-connection.ps1",
    "bot": "node src/telegram-bot.mjs",
    "bot:start": "powershell -ExecutionPolicy Bypass -File scripts/run-bot.ps1",
    "bot:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-bot.ps1",
    "bot:install": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "bot:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "bot:keepalive": "powershell -ExecutionPolicy Bypass -File scripts/keepalive-bot.ps1",
    "disable-photon": "node scripts/disable-photon.mjs",
    "informe:send": "node scripts/send-informe-emails.mjs",
    "informe:send:radio": "node scripts/send-informe-emails.mjs --channel=radio",
    "informe:dry": "node scripts/send-informe-emails.mjs --dry-run",
    "informe:dry:radio": "node scripts/send-informe-emails.mjs --dry-run --channel=radio",
    "informe:cron": "node scripts/informe-cron.mjs",
    "informe:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-informe-cron.ps1",
    "informe:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-informe-cron.ps1",
    "alerts:sync": "node scripts/sync-google-alerts.mjs",
    "alerts:dry": "node scripts/sync-google-alerts.mjs --dry-run",
    "alerts:cron": "node scripts/alerts-cron.mjs",
    "alerts:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-alerts-cron.ps1",
    "alerts:oauth": "node scripts/google-oauth-setup.mjs",
    "electric:sync": "node scripts/sync-electric-alerts.mjs",
    "electric:dry": "node scripts/sync-electric-alerts.mjs --dry-run",
    "intrant:medio": "node scripts/fill-intrant-medio.mjs",
    "intrant:medio:dry": "node scripts/fill-intrant-medio.mjs --dry-run",
    "intrant:medio:install": "powershell -ExecutionPolicy Bypass -File scripts/install-fill-medio-cron.ps1",
    "intrant:purge": "node scripts/purge-stale-intrant.mjs",
    "intrant:purge:dry": "node scripts/purge-stale-intrant.mjs --dry-run",
    "electric:maintain": "node scripts/maintain-electric-sheet.mjs",
    "reports:telegram": "node scripts/send-reports-telegram.mjs",
    "video:remotion": "npm --prefix video/remotion run dev",
    "video:hyperframes": "npm --prefix video/hyperframes run dev",
    "video:hyperframes:render": "npm --prefix video/hyperframes run render",
    "dgcp:digest": "node scripts/send-dgcp-digest.mjs",
    "dgcp:dry": "node scripts/send-dgcp-digest.mjs --dry-run",
    "dgcp:cron": "node scripts/dgcp-cron.mjs",
    "dgcp:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-dgcp-cron.ps1",
    "dgcp:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-dgcp-cron.ps1",
    "frase:test": "node scripts/run-frase-celebre.mjs --test",
    "frase:render": "node scripts/run-frase-celebre.mjs",
    "frase:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-frase-cron.ps1",
    "frase:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-frase-cron.ps1",
    "feed:repost": "node scripts/run-feed-repost.mjs",
    "feed:repost:dry": "node scripts/run-feed-repost.mjs --dry-run",
    "feed:repost:f1": "node scripts/run-feed-repost.mjs --f1",
    "feed:repost:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-feed-repost-cron.ps1",
    "feed:repost:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-feed-repost-cron.ps1",
    "encuestas": "node scripts/run-encuestas.mjs",
    "encuestas:dry": "node scripts/run-encuestas.mjs --dry-run",
    "encuestas:check": "node scripts/run-encuestas.mjs --check",
    "encuestas:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-encuestas-cron.ps1",
    "encuestas:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-encuestas-cron.ps1",
    "report:intrant": "node scripts/run-intrant-report.mjs",
    "report:intrant:dry": "node scripts/run-intrant-report.mjs --dry-run",
    "report:intrant:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-reporte-cron.ps1",
    "report:intrant:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-reporte-cron.ps1",
    "intrant:noticias": "node scripts/run-intrant-site-news.mjs",
    "intrant:noticias:dry": "node scripts/run-intrant-site-news.mjs --dry-run",
    "intrant:noticias:latest": "node scripts/run-intrant-site-news.mjs --force-latest",
    "intrant:noticias:force": "node scripts/run-intrant-site-news.mjs --force",
    "intrant:noticias:cron:install": "powershell -ExecutionPolicy Bypass -File scripts/install-intrant-site-news-cron.ps1",
    "intrant:noticias:cron:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-intrant-site-news-cron.ps1"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "google-tts-api": "^0.0.6",
    "googleapis": "^148.0.0",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "mcp-wordpress": "^3.3.15",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3"
  }
}
